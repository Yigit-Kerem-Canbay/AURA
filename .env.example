# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=aura
DB_USERNAME=aura_user
DB_PASSWORD=aura_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Backend Configuration (Laravel)
APP_NAME=AURA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Internal APIs
PYTHON_SERVICE_URL=http://ai_service:8001
INTERNAL_API_KEY=super_secret_internal_key

# External AI Configuration (Python Service)
LLM_PROVIDER=openai  # e.g., openai, gemini, anthropic
LLM_API_KEY=your_llm_api_key_here
